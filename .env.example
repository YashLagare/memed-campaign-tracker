# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memed_tracker?retryWrites=true&w=majority

# Authentication Configuration
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# Frontend Configuration (for client-side API routing)
NEXT_PUBLIC_API_URL=/api
